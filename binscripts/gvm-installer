#!/usr/bin/env bash
# gvm-rs installer: installs the gvm-rs binary, then runs `gvm-rs init`
# to wire up the shell integration (shim + rc source line).
#
# Usage:
#   curl -fsSL https://raw.githubusercontent.com/nicolas-moon/gvm-rs/main/binscripts/gvm-installer | bash
#
# Release binaries are built by cargo-dist (see .github/workflows/release.yml)
# and are named gvm-rs-<target-triple>.tar.xz — e.g.
#   gvm-rs-x86_64-unknown-linux-gnu.tar.xz
#   gvm-rs-aarch64-apple-darwin.tar.xz
# — each with a .sha256 checksum sidecar. Set GVM_RS_REPO to point at a
# different repo with such releases, or GVM_RS_REPO="" to force the
# `cargo install gvm-rs` path (requires the crate to be on crates.io).
set -euo pipefail

GVM_RS_REPO="${GVM_RS_REPO:-nicolas-moon/gvm-rs}"

err() { echo "gvm-rs installer: $*" >&2; }

target_triples() {
    # Candidate target triples in preference order: on Linux the static
    # musl build comes first because it runs anywhere (glibc distros,
    # NixOS, Alpine); the gnu build is the fallback.
    local sys machine
    sys=$(uname -s)
    machine=$(uname -m)
    case "$sys" in
        Linux)
            case "$machine" in
                x86_64|amd64) echo "x86_64-unknown-linux-musl
x86_64-unknown-linux-gnu" ;;
                aarch64|arm64) echo "aarch64-unknown-linux-musl
aarch64-unknown-linux-gnu" ;;
                *) err "unsupported Linux architecture: $machine"; exit 1 ;;
            esac ;;
        Darwin)
            case "$machine" in
                x86_64|amd64) echo "x86_64-apple-darwin" ;;
                aarch64|arm64) echo "aarch64-apple-darwin" ;;
                *) err "unsupported macOS architecture: $machine"; exit 1 ;;
            esac ;;
        *) err "unsupported OS: $sys (gvm's shell shim is bash/zsh only)"; exit 1 ;;
    esac
}

install_from_release() {
    local triple asset_url sum_url tmp
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    local found=""
    while IFS= read -r triple; do
        asset_url="https://github.com/${GVM_RS_REPO}/releases/latest/download/gvm-rs-${triple}.tar.xz"
        sum_url="${asset_url}.sha256"
        echo "Downloading release binary: ${asset_url}"
        curl -fsSL -o "${tmp}/gvm-rs.tar.xz" "$asset_url" || continue
        if curl -fsSL -o "${tmp}/gvm-rs.tar.xz.sha256" "$sum_url" 2>/dev/null; then
            echo "Verifying checksum…"
            (cd "$tmp" && sha256sum -c gvm-rs.tar.xz.sha256) || { echo "Checksum mismatch for ${asset_url}"; continue; }
        else
            echo "Warning: no .sha256 asset published; skipping checksum verification."
        fi
        # cargo-dist wraps the archive contents in a top-level directory
        # named after the asset; strip it so the binary lands in $tmp.
        tar -xJf "${tmp}/gvm-rs.tar.xz" -C "$tmp" --strip-components=1
        if [ -f "$tmp/gvm-rs" ]; then
            found="$tmp/gvm-rs"
            break
        fi
    done < <(target_triples)
    if [ -z "$found" ]; then
        err "no usable release binary found for this platform in ${GVM_RS_REPO}"
        exit 1
    fi
    echo "$found"
}

install_from_cargo() {
    if ! command -v cargo >/dev/null 2>&1; then
        err "cargo not found. Install Rust from https://rustup.rs, or make sure a release exists for ${GVM_RS_REPO}."
        exit 1
    fi
    echo "Installing gvm-rs via cargo (this compiles and can take a few minutes)…"
    cargo install gvm-rs
}

# 1. Install the binary (already installed? then skip).
if command -v gvm-rs >/dev/null 2>&1; then
    echo "gvm-rs already installed: $(gvm-rs --version)"
elif [ -n "$GVM_RS_REPO" ] && bin_path=$(install_from_release 2>/dev/null); then
    # Prefer $GVM_ROOT/bin so the shim finds it without PATH changes.
    target_dir="${GVM_ROOT:-$HOME/.gvm}/bin"
    mkdir -p "$target_dir"
    mv "$bin_path" "$target_dir"/gvm-rs
    chmod +x "$target_dir/gvm-rs"
    echo "Installed to $target_dir/gvm-rs"
    gvm-rs() { "$target_dir/gvm-rs" "$@"; }
elif [ -n "$GVM_RS_REPO" ]; then
    echo "No release binary available for this platform yet; falling back to cargo install."
    install_from_cargo
else
    install_from_cargo
fi

# 2. Initialize shell integration.
gvm-rs init
